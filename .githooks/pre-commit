#!/usr/bin/env bash
# Lint staged Swift files. Install with `make setup`.
set -euo pipefail

files=()
while IFS= read -r -d '' f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
[ ${#files[@]} -eq 0 ] && exit 0

# ponytail: checks the working tree copy, so a partly staged file is linted as it is on disk.
swiftformat --lint "${files[@]}"
swiftlint lint --strict --quiet --force-exclude "${files[@]}"
